# wayvnc -- bound to this machine's Tailscale IP only, never 0.0.0.0, so only
# tailnet peers can reach it; the tailnet link is WireGuard-encrypted.
# Written by install.sh. The password is prompted at install time and is
# never stored in the repo. VNC auth only uses the first 8 characters.
address=@TSIP@
port=5900
enable_auth=true
password=@PASSWORD@
relax_encryption=true
allow_broken_crypto=true
